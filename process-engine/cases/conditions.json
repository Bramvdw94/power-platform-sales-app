    "type": "condition",
    "input": {
      "table": "opportunity",
      "record": {},
      "parents": {},
      "related": {
        "phoneCalls": [
          {
            "completed": false
          }
        ]
      },
      "group": {
        "match": "all",
        "conditions": [
