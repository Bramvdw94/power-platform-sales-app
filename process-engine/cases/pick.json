  {
    "name": "first match in priority order wins",
    "covers": [
      "#65.1"
    ],
    "type": "pick",
    "input": {
      "table": "opportunity",
      "record": {
        "leadSource": "website"
      },
      "parents": {
        "account": {
          "accountType": "partner"
        }
      },
      "processes": [
        {
          "id": "pPartner",
          "name": "pPartner",
          "table": "opportunity",
          "priority": 1,
          "isFallback": false,
          "retired": false,
          "latestVersionId": "vPartner"
        },
        {
          "id": "pWeb",
          "name": "pWeb",
          "table": "opportunity",
          "priority": 2,
          "isFallback": false,
          "retired": false,
          "latestVersionId": "vWeb"
        },
        {
          "id": "pFb",
          "name": "pFb",
          "table": "opportunity",
          "priority": 3,
          "isFallback": true,
          "retired": false,
          "latestVersionId": "vFb"
        }
      ],
      "versions": [
        {
          "id": "vPartner",
          "processId": "pPartner",
          "definition": {
            "schemaVersion": 1,
            "table": "opportunity",
            "steps": [
              {
                "id": "s1",
                "name": "Qualify",
                "mapsTo": "qualification"
              }
            ],
            "entryCriteria": {
              "match": "all",
              "conditions": [
                {
                  "field": "account.accountType",
                  "op": "equals",
                  "value": "partner"
                }
              ]
            }
          }
        },
        {
          "id": "vWeb",
          "processId": "pWeb",
          "definition": {
            "schemaVersion": 1,
            "table": "opportunity",
            "steps": [
              {
                "id": "s1",
                "name": "Qualify",
                "mapsTo": "qualification"
              }
            ],
            "entryCriteria": {
              "match": "all",
              "conditions": [
                {
                  "field": "leadSource",
                  "op": "equals",
                  "value": "website"
                }
              ]
            }
          }
        },
        {
          "id": "vFb",
          "processId": "pFb",
          "definition": {
            "schemaVersion": 1,
            "table": "opportunity",
            "steps": [
              {
                "id": "s1",
                "name": "Qualify",
                "mapsTo": "qualification"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "processId": "pPartner",
      "versionId": "vPartner"
    }
  },
