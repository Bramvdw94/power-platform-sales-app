  {
    "name": "all comparison operators are valid",
    "covers": [
      "#64.1"
    ],
    "type": "schema",
    "input": {
      "kind": "process",
      "definition": {
        "schemaVersion": 1,
        "table": "opportunity",
        "steps": [
          {
            "id": "s1",
            "name": "x",
            "mapsTo": "qualification",
            "gate": {
              "checks": [
                {
                  "field": "leadSource",
                  "op": "equals",
                  "value": "website"
                },
                {
                  "field": "leadSource",
                  "op": "isNot",
                  "value": "other"
                },
                {
                  "field": "leadSource",
                  "op": "isOneOf",
                  "value": [
                    "website",
                    "event"
                  ]
                },
                {
                  "field": "description",
                  "op": "isEmpty"
                },
                {
                  "field": "description",
                  "op": "isNotEmpty"
                },
                {
                  "field": "estimatedValue",
                  "op": "greaterThan",
                  "value": 100
                },
                {
                  "field": "expectedCloseDate",
                  "op": "lessThan",
                  "value": "2026-12-31"
                }
              ]
            }
          }
        ]
      }
    },
    "expect": {
      "valid": true
    }
  },
