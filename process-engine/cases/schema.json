[
  {
    "name": "a full Opportunity Process is valid",
    "covers": [
      "#66"
    ],
    "type": "schema",
    "input": {
      "kind": "process",
      "definition": {
        "schemaVersion": 1,
        "table": "opportunity",
        "steps": [
          {
            "id": "s1",
            "name": "Qualify",
            "mapsTo": "qualification",
            "keyFields": [
              "description"
            ],
            "gate": {
              "checks": [
                {
                  "field": "description",
                  "op": "isNotEmpty"
                }
              ]
            },
            "actions": [
              {
                "id": "a1",
                "type": "createTask",
                "subject": "Call the customer",
                "dueInDays": 3,
                "assignTo": "owner"
              }
            ]
          },
          {
            "id": "s2",
            "name": "Discover",
            "mapsTo": "needsAnalysis",
            "gate": {
              "checks": [
                {
                  "related": "phoneCalls",
                  "atLeast": 1,
                  "where": [
                    {
                      "field": "completed",
                      "op": "equals",
                      "value": true
                    }
                  ],
                  "sinceStepEntered": true
                }
              ]
            }
          },
          {
            "id": "s3",
            "name": "Propose",
            "mapsTo": "proposal",
            "gate": {
              "checks": [
                {
                  "field": "nextStep",
                  "op": "isNotEmpty"
                }
              ]
            },
            "actions": [
              {
                "id": "a2",
                "type": "createTask",
                "subject": "Review the offer",
                "dueInDays": 5,
                "assignTo": "ownersManager"
              },
              {
                "id": "a3",
                "type": "setField",
                "field": "probability",
                "value": 60
              }
            ]
          },
          {
            "id": "s4",
            "name": "Negotiate",
            "mapsTo": "negotiation",
            "gate": {
              "checks": [
                {
                  "related": "quotes",
                  "atLeast": 1,
                  "where": [
                    {
                      "field": "status",
                      "op": "equals",
                      "value": "sent"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "expect": {
      "valid": true
    }
  },
  {
    "name": "a Process with Entry criteria on a parent field is valid",
    "covers": [
      "#64.2",
      "#65.1"
    ],
    "type": "schema",
    "input": {
      "kind": "process",
      "definition": {
        "schemaVersion": 1,
        "table": "opportunity",
        "steps": [
          {
            "id": "s1",
            "name": "Qualify",
            "mapsTo": "qualification"
          }
        ],
        "entryCriteria": {
          "match": "all",
          "conditions": [
            {
              "field": "account.accountType",
              "op": "equals",
              "value": "partner"
            }
          ]
        }
      }
    },
    "expect": {
      "valid": true
    }
  },
