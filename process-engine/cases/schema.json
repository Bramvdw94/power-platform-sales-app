  {
    "name": "a valid Business rule with every effect",
    "covers": [
      "#64.10"
    ],
    "type": "schema",
    "input": {
      "kind": "rule",
      "definition": {
        "schemaVersion": 1,
        "table": "opportunity",
        "when": {
          "match": "all",
          "conditions": [
            {
              "field": "estimatedValue",
              "op": "greaterThan",
              "value": 50000
            }
          ]
        },
        "effects": [
          {
            "type": "required",
            "field": "nextStep"
          },
          {
            "type": "readOnly",
            "field": "probability"
          },
          {
            "type": "setValue",
            "field": "leadSource",
            "value": "other"
          },
          {
            "type": "warning",
            "message": "Big deal"
          },
          {
            "type": "blockSave",
            "message": "Needs approval"
          }
        ]
      }
    },
    "expect": {
      "valid": true
    }
  },
